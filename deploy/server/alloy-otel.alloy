// Add to server_configs/configs/alloy/config.alloy after configuring a trace backend.
// Keep port 4318 private to the Docker network. Do not add a Traefik/public route.
otelcol.receiver.otlp "loom" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.exporter.prometheus.loom.input]
    traces  = [otelcol.exporter.otlphttp.loom_traces.input]
  }
}

otelcol.exporter.prometheus "loom" {
  forward_to = [prometheus.remote_write.metrics_service.receiver]
}

// Set LOOM_TRACE_ENDPOINT to the base HTTP origin of Tempo or another OTLP backend.
// Configure collector-side authentication/TLS for that backend as required.
otelcol.exporter.otlphttp "loom_traces" {
  client {
    endpoint = sys.env("LOOM_TRACE_ENDPOINT")
  }
}


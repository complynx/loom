// Add to your Alloy configuration.
// Define prometheus.remote_write.metrics_service with your backend URL and credentials.
// The API must be reachable through your private Docker network.
prometheus.scrape "loom" {
    targets = [{"__address__" = "loom:9090", "instance" = "loom"}]
    job_name = "integrations/loom"
    scrape_interval = "15s"
    scrape_timeout = "5s"
    forward_to = [prometheus.remote_write.metrics_service.receiver]
}

// Existing Docker discovery/source already collects application JSON stdout.
// No second Docker log source: it would duplicate ingestion. Query with | json.
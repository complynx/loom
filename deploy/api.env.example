# Copy to deploy/api.env, supply actual credentials, and keep that file private.
CLX_ZITADEL_AUDIENCE=your-harness-audience
CLX_ZITADEL_CLIENT_ID=your-introspection-client-id
CLX_ZITADEL_CLIENT_SECRET=replace-with-client-secret
CLX_MODEL_ENDPOINT=https://api.openai.com/v1
CLX_MODEL_API_KEY=replace-with-provider-key
CLX_ZITADEL_ISSUER=https://id.complynx.net
CLX_ADMIN_ORGANIZATION_ID=replace-with-trusted-admin-org
CLX_MODEL_NAME=replace-with-tested-provider-model
